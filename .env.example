# =============================================================================
# Akhila Funnel — environment variables. Copy to .env.local and fill in.
# NEXT_PUBLIC_* vars are inlined at build time; restart dev / rebuild after edits.
# =============================================================================

# Price tag shown everywhere (hero, CTAs, pricing card, meta, Razorpay order).
NEXT_PUBLIC_ASSESSMENT_FEE_INR=97

# FUNNEL MODE — master switch between the two funnels.
#   true  → FREE lead-capture flow (popup form, no payment, price/refund hidden)
#   false / unset → PAID ₹ Razorpay checkout flow (default)
# Only the literal "true" enables free mode.
NEXT_PUBLIC_FREE_FUNNEL_MODE=false

# Public site URL — drives canonical, OG, and the production-host event gate.
NEXT_PUBLIC_SITE_URL=https://akhila.example.com
NEXT_PUBLIC_SITE_NAME=Dr. Aditya & Akhila's PMOS Metabolic Programme

# Calendly booking link used on /book-a-call.
NEXT_PUBLIC_CALENDLY_URL=

# Razorpay (browser key id + server key id/secret).
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay WEBHOOK secret (SEPARATE from the key secret above). Set it when you
# create the webhook in the Razorpay dashboard (Settings → Webhooks) pointing at
# /api/razorpay/webhook with event payment.captured. Signs every webhook POST.
RAZORPAY_WEBHOOK_SECRET=

# Pabbly Connect webhook (purchase + lead both post here).
PABBLY_PURCHASE_WEBHOOK_URL=

# Meta Pixel + Conversions API.
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=

# Internal test coupon that bypasses Razorpay (leave empty to disable).
BYPASS_COUPON_CODE=
